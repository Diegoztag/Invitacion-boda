# Entorno
NODE_ENV=production
PORT=3000

# Seguridad
JWT_SECRET=tu_secreto_jwt_para_produccion_aqui_muy_seguro
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Autenticación del Dashboard
DASHBOARD_REQUIRE_AUTH=true
DASHBOARD_AUTH_TYPE=basic
DASHBOARD_USERNAME=admin_produccion
DASHBOARD_PASSWORD=password_muy_seguro_produccion

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Configuración de Invitados
GUESTS_TARGET_TOTAL=150
MAX_GUESTS_PER_INVITATION=5
MAX_PASSES_PER_TABLE=10
