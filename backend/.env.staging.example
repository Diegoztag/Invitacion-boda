# Entorno
NODE_ENV=staging
PORT=3000

# Seguridad
JWT_SECRET=tu_secreto_jwt_para_staging_aqui
CORS_ALLOWED_ORIGINS=https://staging.tu-dominio.com

# Autenticación del Dashboard
DASHBOARD_REQUIRE_AUTH=true
DASHBOARD_AUTH_TYPE=basic
DASHBOARD_USERNAME=admin_staging
DASHBOARD_PASSWORD=password_seguro_staging

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Configuración de Invitados
GUESTS_TARGET_TOTAL=150
MAX_GUESTS_PER_INVITATION=5
MAX_PASSES_PER_TABLE=10
