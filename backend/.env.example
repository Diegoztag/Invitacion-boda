# Configuración de Entorno
# Copiar este archivo a .env y actualizar con tus valores

# === SERVER ===
PORT=3000
NODE_ENV=development

# === CORS ===
# Orígenes permitidos (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# === RATE LIMIT ===
# Tiempo en milisegundos para la ventana de rate limit (default: 15 minutos)
RATE_LIMIT_WINDOW_MS=900000
# Máximo de requests por ventana (default: 1000)
RATE_LIMIT_MAX=1000

# === AUTENTICACIÓN DASHBOARD ===
# Requerir autenticación en dashboard (true/false)
DASHBOARD_REQUIRE_AUTH=false
# Tipo de autenticación ('basic', 'jwt')
DASHBOARD_AUTH_TYPE=basic
# Credenciales básicas
DASHBOARD_USERNAME=admin@gmail.com
DASHBOARD_PASSWORD=password

# === SEGURIDAD ===
# Secreto para firmar los tokens JWT (requerido)
JWT_SECRET=un_secreto_muy_seguro_y_largo
# Usuario admin (requerido)
ADMIN_USERNAME=admin
# Contraseña para el usuario admin (requerido)
ADMIN_PASSWORD=admin123

# === INVITADOS ===
# Número total de invitados esperados
GUESTS_TARGET_TOTAL=150
# Máximo de invitados por invitación
MAX_GUESTS_PER_INVITATION=5

# === MESAS ===
# Máximo de pases por mesa
MAX_PASSES_PER_TABLE=10

# === FUTURAS MEJORAS ===
# WHATSAPP_API_KEY=your_whatsapp_api_key
# WHATSAPP_PHONE_NUMBER=+1234567890
# DATABASE_URL=postgresql://user:password@localhost/wedding_db
