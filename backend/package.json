{
    "name": "wedding-invitation-backend",
    "version": "2.0.0",
    "description": "Backend para sistema de invitaciones de boda con Clean Architecture",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "test:unit": "jest --config jest.config.unit.js",
        "test:integration": "jest --config jest.config.integration.js",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "format": "prettier --write src/**/*.js",
        "build": "echo 'No build step required for Node.js'",
        "clean": "rm -rf coverage test-results node_modules",
        "postinstall": "echo 'Backend dependencies installed successfully'"
    },
    "keywords": [
        "wedding",
        "invitation",
        "clean-architecture",
        "nodejs",
        "express",
        "csv"
    ],
    "author": "Wedding Invitation Team",
    "license": "MIT",
    "dependencies": {
        "compression": "^1.7.4",
        "csv-parser": "^3.0.0",
        "csv-writer": "^1.6.0",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.2.0",
        "jsonwebtoken": "^9.0.2",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@babel/core": "^7.23.6",
        "@babel/preset-env": "^7.29.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "babel-jest": "^29.7.0",
        "cypress": "^15.12.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "jest-junit": "^16.0.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "supertest": "^6.3.3"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Diegoztag/Invitacion-boda.git"
    },
    "bugs": {
        "url": "https://github.com/Diegoztag/Invitacion-boda/issues"
    },
    "homepage": "https://github.com/Diegoztag/Invitacion-boda#readme"
}
