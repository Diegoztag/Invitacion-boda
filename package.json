{
    "name": "invitacion-boda",
    "version": "1.0.0",
    "description": "Wedding invitation SPA with integrated live reload",
    "main": "index.js",
    "scripts": {
        "start": "cd backend && npm start",
        "dev": "concurrently \"npm run server\" \"vite\"",
        "build": "vite build",
        "preview": "vite preview",
        "server": "cd backend && npm run dev",
        "install-backend": "cd backend && npm install",
        "postinstall": "npm run install-backend",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,json,md}\"",
        "test:frontend": "npx jest --config=jest.config.frontend.js",
        "test:frontend:watch": "npx jest --config=jest.config.frontend.js --watch",
        "test:frontend:coverage": "npx jest --config=jest.config.frontend.js --coverage",
        "test:backend": "cd backend && npm test"
    },
    "keywords": [
        "wedding",
        "invitation",
        "spa"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/preset-env": "^7.29.2",
        "@testing-library/jest-dom": "^6.9.1",
        "browser-sync": "^3.0.4",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "jest-environment-jsdom": "^30.3.0",
        "prettier": "^3.7.4",
        "sharp": "^0.34.5",
        "svgo": "^4.0.1",
        "vite": "^8.0.9",
        "vite-plugin-image-optimizer": "^2.0.3"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csurf": "^1.11.0",
        "csv-parse": "^6.1.0",
        "csv-stringify": "^6.6.0",
        "dotenv": "^17.2.3",
        "express-rate-limit": "^8.3.2",
        "globals": "^17.4.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.0"
    }
}
